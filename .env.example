# =====================================================================
#  Copiez ce fichier en ".env" et remplissez-le. NE LE PARTAGEZ JAMAIS.
# =====================================================================

# --- MetaTrader 5 (plateforme: mt5) ---------------------------------------
# Laissez vide si MetaTrader 5 est déjà ouvert et connecté à votre compte DÉMO.
# Sinon : numéro de compte démo, mot de passe et nom du serveur du courtier.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Chemin de terminal64.exe si MetaTrader 5 n'est pas trouvé tout seul (facultatif)
MT5_PATH=

# --- eToro (plateforme: etoro) : clé de l'environnement DÉMO, permission Write ---
ETORO_API_KEY=
ETORO_USER_KEY=

# --- IA (optionnel) : une seule suffit, selon ia.fournisseur dans config.yaml ---
ANTHROPIC_API_KEY=
XAI_API_KEY=

# --- SEC (pour les 13F et l'actualité) : votre nom et votre e-mail ---
SEC_USER_AGENT="Prénom Nom vous@exemple.com"

# --- Telegram (optionnel) : pour parler au bot depuis votre téléphone ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Argent réel : second verrou. Laissez "non" tant que vous êtes en démo ---
I_ACCEPT_REAL_MONEY_RISK=non
