# =====================================================================
#  Copiez ce fichier en ".env" et remplissez-le. NE LE PARTAGEZ JAMAIS.
# =====================================================================

# --- eToro (obligatoire) : clé de l'environnement DÉMO, permission Write ---
ETORO_API_KEY=
ETORO_USER_KEY=

# --- IA (optionnel) : une seule suffit, selon ia.fournisseur dans config.yaml ---
ANTHROPIC_API_KEY=
XAI_API_KEY=

# --- SEC (pour les 13F et l'actualité) : votre nom et votre e-mail ---
SEC_USER_AGENT="Prénom Nom vous@exemple.com"

# --- Telegram (optionnel) : pour parler au bot depuis votre téléphone ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Argent réel : second verrou. Laissez "non" tant que vous êtes en démo ---
I_ACCEPT_REAL_MONEY_RISK=non
