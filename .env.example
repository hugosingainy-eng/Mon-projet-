# ───── Accès privé ─────
ADMIN_PASSWORD=choisissez-un-mot-de-passe-long
SESSION_SECRET=une-longue-chaine-aleatoire
PORT=3000
# URL publique (sert aux liens des sites d'aperçu dans les emails)
PUBLIC_URL=http://localhost:3000

# ───── IA : Claude (https://console.anthropic.com) ─────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ───── Google Maps : Places API (New) (https://console.cloud.google.com) ─────
GOOGLE_MAPS_API_KEY=
# Optionnel : clé PageSpeed Insights (sinon GOOGLE_MAPS_API_KEY est utilisée)
PAGESPEED_API_KEY=

# ───── Envoi des emails (SMTP) ─────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Votre Nom <vous@votre-domaine.fr>"

# ───── Votre identité commerciale ─────
SENDER_NAME=Hugo Singainy
SENDER_COMPANY=Votre Agence Web
SENDER_PHONE=
SENDER_EMAIL=
SENDER_WEBSITE=
SENDER_OFFER=Création de site vitrine professionnel, livré en 7 jours

# ───── Exigence du Boss ─────
MAX_REVISIONS=3
BAD_SITE_THRESHOLD=55
