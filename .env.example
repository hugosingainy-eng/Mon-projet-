# ======================= QUANTUM EDGE AI — CONFIGURATION =======================
# Copie ce fichier en ".env" (il n'est JAMAIS envoyé sur GitHub).

# Mode : DEMO uniquement. Toute autre valeur bloque le programme.
TRADING_MODE=DEMO

# Où sont exécutés les ordres :
#   simulated  = 100 % local, gratuit, aucune clé nécessaire (par défaut)
#   etoro_demo = compte DÉMO eToro (argent virtuel), nécessite les 2 clés ci-dessous
EXECUTION_BACKEND=simulated

# Source des données : yahoo (gratuit, sans clé) | etoro | csv | synthetic (tests)
DATA_SOURCE=yahoo

# Clés API eToro (gratuites) : eToro > Paramètres > Trading > API Key Management.
# Environnement : "Virtual" (démo) ; permissions : lecture + écriture (trading).
ETORO_API_KEY=
ETORO_USER_KEY=

# Optionnel (gratuit) : alertes Telegram. Crée un bot avec @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optionnel : jeton pour protéger les boutons du tableau de bord.
DASHBOARD_TOKEN=

# Optionnel et PAYANT : Grok (xAI) pour l'analyse d'actualité. Laisser vide = gratuit.
XAI_API_KEY=
