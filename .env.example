# Clés de l'API publique eToro (Paramètres > Trading > API Key Management)
# Crée une clé avec l'environnement "Virtual / Demo" et la permission "Write".
ETORO_API_KEY=
ETORO_USER_KEY=
# "paper" = simulation 100% locale, "demo" = compte démo eToro (argent virtuel)
BOT_MODE=paper

# Agent Grok (xAI) : analyse des actualités et du sentiment sur X/Twitter et le web.
# Clé à créer sur https://console.x.ai  (facultatif : sans clé, le bot tourne sans Grok)
XAI_API_KEY=
GROK_MODEL=grok-4.7
