{
  "expo": {
    "name": "Confie",
    "slug": "confie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "confie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.confie.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Confie utilise le micro pour que tu puisses lui parler à voix haute.",
        "NSSpeechRecognitionUsageDescription": "Confie transcrit ta voix pour comprendre ce que tu dis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.confie.mobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Confie utilise le micro pour que tu puisses lui parler à voix haute.",
          "speechRecognitionPermission": "Confie transcrit ta voix pour comprendre ce que tu dis."
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}